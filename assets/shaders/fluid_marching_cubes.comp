#version 430
layout (local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

struct Voxel {
    float density; float fluidDensity; float pad1; float pad2;
    vec4 color;
    uint type; uint pad4; uint pad5; uint pad6;
    uint material; uint pad7; uint pad8; uint pad9;
};

struct OutVertex {
    vec4 pos;
    vec4 normal;
    vec4 color;
    vec2 uv;
    vec2 padUV;
    uvec4 flags;
};

struct DrawArraysIndirectCommand {
    uint count;
    uint instanceCount;
    uint first;
    uint baseInstance;
};

layout(std430, binding = 0) readonly buffer Voxels { Voxel voxels[]; };
layout(std430, binding = 1) readonly buffer EdgeTableSSBO { int edgeTable[256]; };
layout(std430, binding = 2) readonly buffer TriTableSSBO { int flattenedTriTable[256*16]; };

layout(std430, binding = 3) buffer Counter { uint vertexCounter; };

layout(std430, binding = 4) buffer Triangles { OutVertex verts[]; };

layout(std430, binding = 5) buffer Indirect { DrawArraysIndirectCommand cmds[]; };

uniform ivec3 voxelGridDim;
uniform vec3 gridOrigin;
uniform float voxelSize;

uniform uint uChunkSlot;
uniform uint uChunkMaxVerts;

uniform int uLodStep;
uniform float uNormalH;

int voxelIndex(ivec3 p) {
    return p.x + p.y * voxelGridDim.x + p.z * voxelGridDim.x * voxelGridDim.y;
}
ivec3 clampVoxel(ivec3 p) { return clamp(p, ivec3(0), voxelGridDim - ivec3(1)); }

float sampleFluidDensity(ivec3 p) {
    int idx = voxelIndex(clampVoxel(p));
    return voxels[idx].fluidDensity;
}

vec3 sampleFluidColor(ivec3 p) {
    int idx = voxelIndex(clampVoxel(p));
    return voxels[idx].color.xyz;
}

vec2 computePlanarUV(vec3 worldPos) { return worldPos.xz * 0.1; }

vec3 voxelWorldPos(ivec3 v) { return gridOrigin + vec3(v) * voxelSize; }

vec3 vertexInterpolate(vec3 p1, vec3 p2, float d1, float d2) {
    float denom = (d1 - d2);
    float t = abs(denom) < 1e-6 ? 0.5 : (d1 / denom);
    return mix(p1, p2, clamp(t, 0.0, 1.0));
}

float sampleDensityTrilinear(vec3 idxF) {
    vec3 p = clamp(idxF, vec3(0.0), vec3(voxelGridDim) - vec3(1.001));
    ivec3 i0 = ivec3(floor(p));
    ivec3 i1 = min(i0 + ivec3(1), voxelGridDim - ivec3(1));
    vec3 f = fract(p);

    float d000 = sampleFluidDensity(i0);
    float d100 = sampleFluidDensity(ivec3(i1.x, i0.y, i0.z));
    float d010 = sampleFluidDensity(ivec3(i0.x, i1.y, i0.z));
    float d110 = sampleFluidDensity(ivec3(i1.x, i1.y, i0.z));
    float d001 = sampleFluidDensity(ivec3(i0.x, i0.y, i1.z));
    float d101 = sampleFluidDensity(ivec3(i1.x, i0.y, i1.z));
    float d011 = sampleFluidDensity(ivec3(i0.x, i1.y, i1.z));
    float d111 = sampleFluidDensity(i1);

    float d00 = mix(d000, d100, f.x);
    float d10 = mix(d010, d110, f.x);
    float d01 = mix(d001, d101, f.x);
    float d11 = mix(d011, d111, f.x);

    float d0 = mix(d00, d10, f.y);
    float d1 = mix(d01, d11, f.y);

    return mix(d0, d1, f.z);
}
vec3 computeNormal(vec3 worldPos) {
    vec3 idxF = (worldPos - gridOrigin) / voxelSize;
    idxF = clamp(idxF, vec3(1.0), vec3(voxelGridDim) - vec3(2.0));
    const float h = uNormalH;
    float dx = sampleDensityTrilinear(idxF + vec3(h,0,0)) - sampleDensityTrilinear(idxF - vec3(h,0,0));
    float dy = sampleDensityTrilinear(idxF + vec3(0,h,0)) - sampleDensityTrilinear(idxF - vec3(0,h,0));
    float dz = sampleDensityTrilinear(idxF + vec3(0,0,h)) - sampleDensityTrilinear(idxF - vec3(0,0,h));
    vec3 g = vec3(dx, dy, dz);
    float len = length(g);
    return (len > 1e-8) ? (-g / len) : vec3(0,1,0);
}

bool reserveVertices(uint count, out uint localIdx)
{
    localIdx = 0u;

    if (uChunkMaxVerts < count) {
        return false;
    }

    uint current = vertexCounter;

    while (true) {
        if (current > uChunkMaxVerts - count) {
            return false;
        }

        uint previous = atomicCompSwap(
        vertexCounter,
        current,
        current + count
        );

        if (previous == current) {
            localIdx = current;
            return true;
        }

        current = previous;
    }

    return false;
}

void main() {
    ivec3 cell = ivec3(gl_GlobalInvocationID);
    ivec3 cellsDim = voxelGridDim - ivec3(1);

    if (any(greaterThanEqual(cell, cellsDim))) {
        return;
    }

    ivec3 p0 = cell;
    ivec3 p1 = cell + ivec3(1, 0, 0);
    ivec3 p2 = cell + ivec3(1, 1, 0);
    ivec3 p3 = cell + ivec3(0, 1, 0);
    ivec3 p4 = cell + ivec3(0, 0, 1);
    ivec3 p5 = cell + ivec3(1, 0, 1);
    ivec3 p6 = cell + ivec3(1, 1, 1);
    ivec3 p7 = cell + ivec3(0, 1, 1);

    ivec3 corners[8] = ivec3[](
    p0, p1, p2, p3,
    p4, p5, p6, p7
    );

    float d[8];
    uint cornerMaterial[8];
    int cornerVoxelIndex[8];

    for (int i = 0; i < 8; ++i) {
        int voxelIdx = voxelIndex(corners[i]);
        Voxel voxel = voxels[voxelIdx];

        cornerVoxelIndex[i] = voxelIdx;
        cornerMaterial[i] = voxel.material;
        d[i] = voxel.fluidDensity;
    }

    const float EPS = 1e-6;

    int caseIndex = 0;
    for (int i = 0; i < 8; ++i) {
        if (d[i] > EPS) {
            caseIndex |= (1 << i);
        }
    }

    int edgeMask = edgeTable[caseIndex];
    if (edgeMask == 0) {
        return;
    }

    int triBase = caseIndex * 16;

    int triangleCount = 0;
    for (int tri = 0; tri < 16; tri += 3) {
        if (flattenedTriTable[triBase + tri] == -1) {
            break;
        }
        ++triangleCount;
    }

    uint vertexCountForCell = uint(triangleCount * 3);

    uint localBase;
    if (!reserveVertices(vertexCountForCell, localBase)) {
        return;
    }

    uint baseVert = uChunkSlot * uChunkMaxVerts;

    // Select one material for the complete cell once.
    // Match the previous behavior: use the material of the corner with the
    // strongest positive fluid density.
    uint cellMaterial = 0u;
    float strongestDensity = EPS;

    for (int i = 0; i < 8; ++i) {
        if (d[i] > strongestDensity) {
            strongestDensity = d[i];
            cellMaterial = cornerMaterial[i];
        }
    }

    const uint FLUID_BIT = 1u << 7;
    uint packedFlags = ((cellMaterial & 63u) << 1) | FLUID_BIT;

    vec3 pos[8];
    vec3 color[8];

    for (int i = 0; i < 8; ++i) {
        pos[i] = voxelWorldPos(corners[i]);

        color[i] = voxels[cornerVoxelIndex[i]].color.xyz;
    }

    const int edgeToCornerA[12] = int[](
    0, 1, 2, 3,
    4, 5, 6, 7,
    0, 1, 2, 3
    );

    const int edgeToCornerB[12] = int[](
    1, 2, 3, 0,
    5, 6, 7, 4,
    4, 5, 6, 7
    );

    vec3 edgeVertex[12];
    vec3 edgeColor[12];

    for (int edge = 0; edge < 12; ++edge) {
        if ((edgeMask & (1 << edge)) == 0) {
            continue;
        }

        int a = edgeToCornerA[edge];
        int b = edgeToCornerB[edge];

        float denom = d[a] - d[b];
        float t = abs(denom) < 1e-6
        ? 0.5
        : clamp(d[a] / denom, 0.0, 1.0);

        edgeVertex[edge] = mix(pos[a], pos[b], t);
        edgeColor[edge] = mix(color[a], color[b], t);
    }

    for (int triangle = 0; triangle < triangleCount; ++triangle) {
        int tableOffset = triBase + triangle * 3;

        int i0 = flattenedTriTable[tableOffset + 0];
        int i1 = flattenedTriTable[tableOffset + 1];
        int i2 = flattenedTriTable[tableOffset + 2];

        vec3 v0 = edgeVertex[i0];
        vec3 v1 = edgeVertex[i1];
        vec3 v2 = edgeVertex[i2];

        vec3 col0 = edgeColor[i0];
        vec3 col1 = edgeColor[i1];
        vec3 col2 = edgeColor[i2];

        vec3 faceNormal = cross(v1 - v0, v2 - v0);
        float faceNormalLength = length(faceNormal);

        faceNormal = faceNormalLength > 1e-9
        ? faceNormal / faceNormalLength
        : vec3(0.0, 1.0, 0.0);

        vec3 n0 = computeNormal(v0);

        if (dot(faceNormal, n0) < 0.0) {
            vec3 tempVertex = v1;
            v1 = v2;
            v2 = tempVertex;

            vec3 tempColor = col1;
            col1 = col2;
            col2 = tempColor;

            faceNormal = -faceNormal;
        }

        vec3 n1 = computeNormal(v1);
        vec3 n2 = computeNormal(v2);

        uint idx = baseVert + localBase + uint(triangle * 3);

        verts[idx + 0].pos = vec4(v0, 1.0);
        verts[idx + 0].normal = vec4(n0, 0.0);
        verts[idx + 0].color = vec4(col0, 1.0);
        verts[idx + 0].uv = computePlanarUV(v0);
        verts[idx + 0].flags = uvec4(packedFlags, 0u, 0u, 0u);

        verts[idx + 1].pos = vec4(v1, 1.0);
        verts[idx + 1].normal = vec4(n1, 0.0);
        verts[idx + 1].color = vec4(col1, 1.0);
        verts[idx + 1].uv = computePlanarUV(v1);
        verts[idx + 1].flags = uvec4(packedFlags, 0u, 0u, 0u);

        verts[idx + 2].pos = vec4(v2, 1.0);
        verts[idx + 2].normal = vec4(n2, 0.0);
        verts[idx + 2].color = vec4(col2, 1.0);
        verts[idx + 2].uv = computePlanarUV(v2);
        verts[idx + 2].flags = uvec4(packedFlags, 0u, 0u, 0u);
    }
}